extends layout

block content
  .checkout-banner.glass-card
    .banner-content
      h3.banner-title Setup Billing & Payment
      p.banner-text Enter your credit card details to prepare for premium consultations.
    a.btn.btn-emerald(href='/checkout', id='btn-go-to-checkout')
      span Add Credit Card &rarr;

  .game-grid
    each game in games
      a.game-card(href='/game/' + game.id)
        .game-image-container
          img(src=game.image || '/images/default.png', alt=game.name)
        .game-details
          .game-name= game.name
          .game-description= game.description
          .game-action
            span Consult Master &rarr;