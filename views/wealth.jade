extends layout

block content
  style.
    /* Tavern Portfolio Advisor Custom Styles */
    :root {
      --emerald-glow: #10b981;
      --emerald-light: #34d399;
      --tavern-border: 1px solid rgba(16, 185, 129, 0.2);
      --tavern-border-hover: 1px solid rgba(52, 211, 153, 0.45);
      --tavern-gold: #fbbf24;
    }
    
    .catan-container {
      display: grid;
      grid-template-columns: 3fr 1fr;
      gap: 30px;
      margin-bottom: 40px;
      width: 100%;
    }
    
    @media (max-width: 1200px) {
      .catan-container {
        grid-template-columns: 1fr;
      }
    }
    
    .portfolio-top-row {
      display: grid;
      grid-template-columns: 1.2fr 1fr 1fr;
      gap: 30px;
      align-items: start;
    }
    
    .portfolio-top-row .glass-card {
      margin-bottom: 0 !important;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    
    @media (max-width: 1450px) {
      .portfolio-top-row {
        grid-template-columns: 1fr 1fr;
      }
      .portfolio-top-row > :first-child {
        grid-column: span 2;
      }
    }
    
    @media (max-width: 768px) {
      .portfolio-top-row {
        grid-template-columns: 1fr;
      }
      .portfolio-top-row > :first-child {
        grid-column: span 1;
      }
    }
    
    .rec-badge {
      font-size: 0.72rem;
      padding: 2px 7px;
      border-radius: 4px;
      font-weight: bold;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    
    /* Market Tag */
    .market-tag {
      font-size: 0.85rem;
      font-weight: bold;
      text-transform: uppercase;
      padding: 4px 12px;
      border-radius: 4px;
      color: #fff;
      letter-spacing: 0.5px;
    }
    
    .market-tag.stable { background: #10b981; box-shadow: 0 0 8px rgba(16, 185, 129, 0.4); }
    .market-tag.bear { background: #b91c1c; box-shadow: 0 0 8px rgba(185, 28, 28, 0.4); }
    .market-tag.bull { background: #fbbf24; color: #000; box-shadow: 0 0 8px rgba(251, 191, 36, 0.4); }
    .market-tag.volatile { background: #a21caf; box-shadow: 0 0 8px rgba(162, 28, 175, 0.4); }
    
    /* Table styles */
    .financial-table {
      width: 100%;
      border-collapse: collapse;
      margin: 20px 0;
      font-size: 0.95rem;
    }
    
    .financial-table th {
      border-bottom: 2px solid rgba(16, 185, 129, 0.3);
      color: #94a3b8;
      text-align: left;
      padding: 12px 8px;
      font-weight: 600;
    }
    
    .financial-table td {
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      padding: 15px 8px;
      color: #fff;
    }
    
    .financial-table tr:last-child td {
      border-bottom: none;
    }
    
    .financial-table tbody tr {
      cursor: pointer;
      transition: all 0.2s ease;
      border-left: 3px solid transparent;
    }
    
    .financial-table tbody tr:hover {
      background: rgba(16, 185, 129, 0.05);
    }
    
    .financial-table tbody tr.selected {
      background: rgba(16, 185, 129, 0.12);
      border-left-color: var(--emerald-glow);
    }
    
    .financial-table tbody tr.recommended {
      border-left-color: var(--tavern-gold);
    }
    
    /* Buttons */
    .schwab-btn-primary {
      background: var(--emerald-glow);
      color: #030806;
      border: none;
      border-radius: 6px;
      padding: 14px 24px;
      font-family: var(--font-body);
      font-weight: 700;
      cursor: pointer;
      text-align: center;
      transition: all 0.2s;
      box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
    }
    
    .schwab-btn-primary:hover {
      background: var(--emerald-light);
      transform: translateY(-2px);
      box-shadow: 0 6px 15px rgba(52, 211, 153, 0.5);
    }
    
    .schwab-btn-primary:disabled {
      background: rgba(255, 255, 255, 0.1);
      color: rgba(255, 255, 255, 0.3);
      cursor: not-allowed;
      box-shadow: none;
      transform: none;
    }
    
    .choice-group {
      display: grid;
      grid-template-columns: 1fr;
      gap: 12px;
      margin: 20px 0;
    }
    
    .schwab-choice-btn {
      color: #fff;
      border-radius: 6px;
      padding: 15px 20px;
      text-align: left;
      cursor: pointer;
      font-family: var(--font-body);
      transition: all 0.2s;
    }
    
    .schwab-choice-btn:hover {
      transform: translateX(4px);
    }
    
    /* Choice buttons color overrides to match asset classes */
    #btn-choice-0 {
      background: rgba(56, 189, 248, 0.02);
      border: 1px solid rgba(56, 189, 248, 0.25);
    }
    #btn-choice-0:hover {
      background: rgba(56, 189, 248, 0.08);
      border-color: #38bdf8;
    }
    #btn-choice-0.selected {
      background: rgba(56, 189, 248, 0.18);
      border-color: #38bdf8;
      box-shadow: 0 0 12px rgba(56, 189, 248, 0.25);
    }
    #rec-badge-0 {
      background: rgba(56, 189, 248, 0.12);
      color: #38bdf8;
      border-color: rgba(56, 189, 248, 0.3);
    }
    
    #btn-choice-1 {
      background: rgba(245, 158, 11, 0.02);
      border: 1px solid rgba(245, 158, 11, 0.25);
    }
    #btn-choice-1:hover {
      background: rgba(245, 158, 11, 0.08);
      border-color: #f59e0b;
    }
    #btn-choice-1.selected {
      background: rgba(245, 158, 11, 0.18);
      border-color: #f59e0b;
      box-shadow: 0 0 12px rgba(245, 158, 11, 0.25);
    }
    #rec-badge-1 {
      background: rgba(245, 158, 11, 0.12);
      color: #f59e0b;
      border-color: rgba(245, 158, 11, 0.3);
    }
    
    #btn-choice-2 {
      background: rgba(236, 72, 153, 0.02);
      border: 1px solid rgba(236, 72, 153, 0.25);
    }
    #btn-choice-2:hover {
      background: rgba(236, 72, 153, 0.08);
      border-color: #ec4899;
    }
    #btn-choice-2.selected {
      background: rgba(236, 72, 153, 0.18);
      border-color: #ec4899;
      box-shadow: 0 0 12px rgba(236, 72, 153, 0.25);
    }
    #rec-badge-2 {
      background: rgba(236, 72, 153, 0.12);
      color: #ec4899;
      border-color: rgba(236, 72, 153, 0.3);
    }
    
    /* Bayesian Profiler styling */
    .stat-header {
      font-family: var(--font-heading);
      color: var(--tavern-gold);
      font-size: 1.25rem;
      border-bottom: 2px solid rgba(16, 185, 129, 0.3);
      padding-bottom: 12px;
      margin-bottom: 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      letter-spacing: 0.5px;
    }
    
    .formula-badge {
      font-size: 0.75rem;
      background: rgba(251, 191, 36, 0.15);
      color: var(--tavern-gold);
      border: 1px solid rgba(251, 191, 36, 0.3);
      padding: 4px 10px;
      border-radius: 20px;
      font-family: monospace;
    }
    
    .strategy-item {
      margin-bottom: 20px;
    }
    
    .strategy-info {
      display: flex;
      justify-content: space-between;
      margin-bottom: 8px;
      font-size: 0.9rem;
    }
    
    .strategy-name {
      font-weight: 500;
      color: #fff;
    }
    
    .strategy-percentage {
      font-family: monospace;
      color: var(--emerald-light);
      font-weight: 700;
    }
    
    .bar-bg {
      background: rgba(255, 255, 255, 0.05);
      height: 10px;
      border-radius: 5px;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.05);
    }
    
    .bar-fill {
      height: 100%;
      width: 33.33%;
      border-radius: 5px;
      transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    #bar-cons {
      background: linear-gradient(90deg, #005a9c, #38bdf8);
      box-shadow: 0 0 8px rgba(56, 189, 248, 0.4);
    }
    
    #bar-mod {
      background: linear-gradient(90deg, #d97706, #fbbf24);
      box-shadow: 0 0 8px rgba(251, 191, 36, 0.4);
    }
    
    #bar-aggr {
      background: linear-gradient(90deg, #db2777, #ec4899);
      box-shadow: 0 0 8px rgba(236, 72, 153, 0.4);
    }
    
    /* Math Log styles */
    .schwab-math-log {
      max-height: 160px;
      overflow-y: auto;
      font-family: monospace;
      font-size: 0.85rem;
      background: rgba(0, 0, 0, 0.35);
      border-radius: 6px;
      padding: 15px;
      border: 1px solid rgba(255, 255, 255, 0.05);
      color: #94a3b8;
    }
    
    .math-entry {
      border-left: 2px solid var(--emerald-glow);
      padding-left: 10px;
      margin-bottom: 10px;
    }
    
    .math-entry.header {
      border-left-color: var(--tavern-gold);
      font-weight: bold;
      color: #fff;
    }

  <!-- Standalone Game Container (Extends Layout) -->
  .catan-container
    <!-- LEFT: Treasury Dashboard -->
    div(style="display:flex; flex-direction:column; gap:30px;")
      .glass-card
        .scenario-title(style="display:flex; justify-content:between; align-items:center;")
          span(style="font-family: var(--font-heading); color: var(--tavern-gold);") Treasury Investment Ledger
          span.market-tag.stable#market-ticker Stable Harvest
            
        .scenario-description(style="margin-bottom: 5px; color: var(--text-secondary);") Total vault treasury and dynamic asset allocations:
        .balance-display#total-balance(style="font-size: 2.2rem; font-weight: 700; color: #fff; margin: 10px 0;") 10,000 Gold
        .change-badge.positive#daily-change(style="display:inline-block; font-size:0.95rem; font-weight:600; padding:3px 10px; border-radius:20px; margin-bottom:15px; background:rgba(34,197,94,0.15); color:#22c55e; border:1px solid rgba(34,197,94,0.3);") +0 Gold (+0.0%)
        
        table.financial-table
          thead
            tr
              th Asset Tier
              th Vault Description
              th Balance (Gold)
              th Allocation (%)
              th Yield Shift
          tbody
            tr#row-choice-0(onclick="selectAllocation(0)")
              td(style="color:#38bdf8; font-weight:600;") Bonds &amp; CDs
              td Dwarven Bonds &amp; Vault Certificates
              td#bal-low 3,333.33 Gold
              td
                div(style="display:flex; align-items:center; gap:8px;")
                  span#alloc-low 33.3%
                  div(style="flex-grow:1; background:rgba(255,255,255,0.08); height:6px; border-radius:3px; overflow:hidden; min-width:60px;")
                    div#alloc-bar-low(style="background:#38bdf8; height:100%; width:33.3%; transition:width 0.3s ease;")
              td#vol-low(style="color:#22c55e;") +0.8%
            tr#row-choice-1(onclick="selectAllocation(1)")
              td(style="color:#f59e0b; font-weight:600;") Real Estate &amp; Stocks
              td Merchant Properties &amp; Guild Stocks
              td#bal-med 3,333.33 Gold
              td
                div(style="display:flex; align-items:center; gap:8px;")
                  span#alloc-med 33.3%
                  div(style="flex-grow:1; background:rgba(255,255,255,0.08); height:6px; border-radius:3px; overflow:hidden; min-width:60px;")
                    div#alloc-bar-med(style="background:#f59e0b; height:100%; width:33.3%; transition:width 0.3s ease;")
              td#vol-med(style="color:#22c55e;") +2.5%
            tr#row-choice-2(onclick="selectAllocation(2)")
              td(style="color:#ec4899; font-weight:600;") Crypto &amp; Startups
              td Mana Crystal Crypto &amp; Gnomish Startups
              td#bal-high 3,333.34 Gold
              td
                div(style="display:flex; align-items:center; gap:8px;")
                  span#alloc-high 33.3%
                  div(style="flex-grow:1; background:rgba(255,255,255,0.08); height:6px; border-radius:3px; overflow:hidden; min-width:60px;")
                    div#alloc-bar-high(style="background:#ec4899; height:100%; width:33.3%; transition:width 0.3s ease;")
              td#vol-high(style="color:#22c55e;") +5.0%

      div(style="display:flex; flex-direction:column; gap:20px;")
        .advisor-bubble(style="background:rgba(16,185,129,0.08); border-left:4px solid var(--emerald-glow); border-radius:0 12px 12px 0; padding:20px; color:var(--text-primary); font-style:italic; line-height:1.5;")
          strong#advisor-title(style="font-family: var(--font-heading); color: var(--tavern-gold); font-style:normal; display:block; margin-bottom:8px;") Iron Bank Advisor Guidance
          span#advisor-text Welcome to the treasury room. Choose a rebalancing strategy below. I will observe your allocation ratios across stable Dwarven bonds, moderate merchant stocks, and highly volatile crystal startups to assess your risk profile and advise you.

        <!-- Interactive Decision Card -->
        .glass-card(style="min-height:300px; display:flex; flex-direction:column; justify-content:space-between; margin-bottom:0;")
          div#schwab-choices-box
            .scenario-title#step-title(style="font-family: var(--font-heading); color: var(--tavern-gold); font-size: 1.4rem; margin-bottom: 12px;") Season 1: Stable Harvest
            .scenario-description#step-desc(style="color: var(--text-secondary); font-size: 0.95rem; line-height: 1.6; margin-bottom:20px;") Markets are tranquil. Review current asset valuations above and select your target rebalancing preset.
            
            .choice-group
              button.schwab-choice-btn#btn-choice-0(onclick="selectAllocation(0)")
                div(style="display:flex; justify-content:space-between; align-items:center;")
                  strong(style="color:#38bdf8;") Conservative Strategy (Low Risk)
                  span.rec-badge#rec-badge-0(style="display:none;") Previous Strategy
                br
                span.text-muted Target: 70% Bonds &amp; CDs, 20% Real Estate &amp; Stocks, 10% Crypto &amp; Startups
              button.schwab-choice-btn#btn-choice-1(onclick="selectAllocation(1)")
                div(style="display:flex; justify-content:space-between; align-items:center;")
                  strong(style="color:#f59e0b;") Moderate Strategy (Medium Risk)
                  span.rec-badge#rec-badge-1(style="display:none;") Previous Strategy
                br
                span.text-muted Target: 20% Bonds &amp; CDs, 60% Real Estate &amp; Stocks, 20% Crypto &amp; Startups
              button.schwab-choice-btn#btn-choice-2(onclick="selectAllocation(2)")
                div(style="display:flex; justify-content:space-between; align-items:center;")
                  strong(style="color:#ec4899;") Risky Strategy (High Risk)
                  span.rec-badge#rec-badge-2(style="display:none;") Previous Strategy
                br
                span.text-muted Target: 10% Bonds &amp; CDs, 15% Real Estate &amp; Stocks, 75% Crypto &amp; Startups

          div(style="text-align:right; margin-top:20px;")
            button.schwab-btn-primary#next-turn-btn(onclick="processTurn()", disabled) Apply Rebalance &amp; Advance Season
            button.schwab-btn-primary#reset-btn(onclick="resetSimulator()", style="display:none;") Reset Vault Simulation

      <!-- Vault Performance History -->
      .glass-card
        .scenario-title(style="font-family: var(--font-heading); color: var(--tavern-gold);") Vault Performance History
        .board-wrapper(style="background:rgba(0,0,0,0.3); border-radius:6px; padding:15px; display:flex; justify-content:center; align-items:center; border:1px solid rgba(255,255,255,0.05);")
          svg(viewBox="0 0 400 110", width="100%")
          
            defs
              linearGradient#emerald-grad(x1="0%", y1="0%", x2="100%", y2="0%")
                stop(offset="0%", stop-color="#064e3b")
                stop(offset="100%", stop-color="#34d399")

            <!-- Grid lines -->
            line(x1="20", y1="10", x2="380", y2="10", stroke="rgba(255,255,255,0.05)", stroke-width="1")
            line(x1="20", y1="50", x2="380", y2="50", stroke="rgba(255,255,255,0.05)", stroke-width="1")
            line(x1="20", y1="90", x2="380", y2="90", stroke="rgba(255,255,255,0.05)", stroke-width="1")
            
            <!-- Season labels -->
            text(x="20", y="105", fill="#64748b", font-size="8", text-anchor="middle") Start
            text(x="110", y="105", fill="#64748b", font-size="8", text-anchor="middle") Season 1
            text(x="200", y="105", fill="#64748b", font-size="8", text-anchor="middle") Season 2
            text(x="290", y="105", fill="#64748b", font-size="8", text-anchor="middle") Season 3
            text(x="380", y="105", fill="#64748b", font-size="8", text-anchor="middle") Season 4
            
            <!-- Value Labels on Right -->
            text(x="395", y="14", fill="#64748b", font-size="7", text-anchor="start") 13K G
            text(x="395", y="54", fill="#64748b", font-size="7", text-anchor="start") 10K G
            text(x="395", y="94", fill="#64748b", font-size="7", text-anchor="start") 7K G

            <!-- Line Path -->
            path#history-line(d="M 20,50 L 110,50 L 200,50 L 290,50 L 380,50", fill="none", stroke="url(#emerald-grad)", stroke-width="2.5")
            
            <!-- Point Circles -->
            circle#pt-0(cx="20", cy="50", r="3.5", fill="#10b981", stroke="#fff")
            circle#pt-1(cx="110", cy="50", r="3.5", fill="#10b981", stroke="#fff", style="display:none;")
            circle#pt-2(cx="200", cy="50", r="3.5", fill="#10b981", stroke="#fff", style="display:none;")
            circle#pt-3(cx="290", cy="50", r="3.5", fill="#10b981", stroke="#fff", style="display:none;")
            circle#pt-4(cx="380", cy="50", r="3.5", fill="#10b981", stroke="#fff", style="display:none;")

    <!-- RIGHT: Bayesian Belief Analytics -->
    .bayesian-panel
      .glass-card
        .stat-header
          span Bayesian Risk Profiler
          span.formula-badge P(Profile|Choice)
          
        .strategy-item
          .strategy-info
            span.strategy-name Conservative Profile
            span.strategy-percentage#prob-cons 33.3%
          .bar-bg
            .bar-fill#bar-cons(style="width: 33.33%")
            
        .strategy-item
          .strategy-info
            span.strategy-name Moderate Profile
            span.strategy-percentage#prob-mod 33.3%
          .bar-bg
            .bar-fill#bar-mod(style="width: 33.33%")
            
        .strategy-item
          .strategy-info
            span.strategy-name Risky Profile
            span.strategy-percentage#prob-aggr 33.3%
          .bar-bg
            .bar-fill#bar-aggr(style="width: 33.33%")

      .glass-card
        .stat-header Bayesian Audit Log
        .schwab-math-log#math-log-container
          .math-entry.header Prior risk model initialized.
          .math-entry P(Conservative) = 0.333 | P(Moderate) = 0.333 | P(Risky) = 0.333

  script.
    // SCENARIOS & MARKET MOVES
    const MARKET_STATES = [
      { tag: "stable", text: "Stable Harvest", desc: "Markets are tranquil. Review current asset valuations above and select your target rebalancing preset." },
      { tag: "bear", text: "Orc Invasion (Crash)", desc: "A devastating orc siege sweeps the kingdom! Risky crystal startups fall 24%, while Dwarven CDs protect your principal. Reallocate your reserves." },
      { tag: "bull", text: "Elven Golden Age", desc: "An era of magical prosperity! Dragon venture startups soar by 32% this season. Decide whether to lock in gains or double down." },
      { tag: "volatile", text: "Wizard's Tempest", desc: "A magical storm of market volatility! Asset returns are unpredictable and swing wildly. Make your final portfolio adjustments." }
    ];

    const VOLATILITIES = {
      0: [0.008, 0.025, 0.050],   // Season 1: Stable
      1: [-0.002, -0.060, -0.240], // Season 2: Bear Crash
      2: [0.012, 0.085, 0.320],    // Season 3: Bull Rally
      3: [0.005, -0.015, -0.150]   // Season 4: Volatile
    };

    const STRATEGY_PRESETS = [
      [0.70, 0.20, 0.10], // Conservative Preset: 70/20/10
      [0.20, 0.60, 0.20], // Moderate Preset: 20/60/20
      [0.10, 0.15, 0.75]  // Risky Preset: 10/15/75
    ];

    // LIKELIHOOD VALUES: P(Choice | Profile)
    // Profiles: 0 = Conservative, 1 = Moderate, 2 = Risky
    const LIKELIHOODS = {
      0: { // Stage 0: Stable
        0: [0.70, 0.20, 0.10], 
        1: [0.20, 0.70, 0.10], 
        2: [0.10, 0.10, 0.80]  
      },
      1: { // Stage 1: Bear Crash
        0: [0.80, 0.40, 0.10], // Choice 0
        1: [0.15, 0.50, 0.20], // Choice 1
        2: [0.05, 0.10, 0.70]  // Choice 2
      },
      2: { // Stage 2: Bull Rally
        0: [0.60, 0.25, 0.05], // Choice 0
        1: [0.30, 0.60, 0.15], // Choice 1
        2: [0.10, 0.15, 0.80]  // Choice 2
      },
      3: { // Stage 3: Volatile
        0: [0.80, 0.30, 0.10], 
        1: [0.15, 0.60, 0.20], 
        2: [0.05, 0.10, 0.70]  
      }
    };

    const ADVISOR_RESPONSES = [
      // Conservative
      {
        title: "Iron Bank Advisor: Dwarven Safety Guidance",
        text: "Your allocation choices indicate a conservative mindset, prioritizing principal safety. We suggest maintaining a heavy allocation in Dwarven Gold Bonds & CDs to secure your gold. Use only a tiny portion for startups to offset inflation."
      },
      // Moderate
      {
        title: "Iron Bank Advisor: Balanced Guild Guidance",
        text: "You display a moderate risk appetite. We recommend a balanced strategy: keeping the majority of your vault in Guild properties and blue-chip merchant assets for steady long-term growth, with bonds protecting your downside."
      },
      // Risky
      {
        title: "Iron Bank Advisor: Adventurous Venture Guidance",
        text: "You demonstrate a highly risky profile, capitalizing on wild crypto and startup swings. While this offers substantial upside, make sure to keep a solid cash reserve in secure CDs so a wizard's tempest doesn't wipe you out."
      }
    ];

    // Initial state
    let totalValue = 10000;
    let assetValues = [3333.33, 3333.33, 3333.34];
    let selectedAllocIndex = -1;
    let turnHistory = [10000];
    
    let probabilities = [0.3333, 0.3333, 0.3333];
    let currentTurn = 0;

    function selectAllocation(index) {
      selectedAllocIndex = index;
      
      // Toggle button and row active classes
      for (let i = 0; i < 3; i++) {
        const btn = document.getElementById(`btn-choice-${i}`);
        const row = document.getElementById(`row-choice-${i}`);
        if (i === index) {
          if (btn) btn.classList.add('selected');
          if (row) row.classList.add('selected');
        } else {
          if (btn) btn.classList.remove('selected');
          if (row) row.classList.remove('selected');
        }
      }
      
      // Enable Next Turn Button
      document.getElementById('next-turn-btn').removeAttribute('disabled');
    }

    function processTurn() {
      if (selectedAllocIndex === -1) return;
      
      // 1. Rebalance portfolio to chosen strategy preset first
      const preset = STRATEGY_PRESETS[selectedAllocIndex];
      assetValues[0] = totalValue * preset[0];
      assetValues[1] = totalValue * preset[1];
      assetValues[2] = totalValue * preset[2];

      // 2. Bayesian Update: Posterior = Likelihood * Prior
      const choiceLikelihoods = LIKELIHOODS[currentTurn][selectedAllocIndex];
      const priors = [...probabilities];
      
      let posteriors = [0, 0, 0];
      let numeratorSum = 0;
      for (let i = 0; i < 3; i++) {
        posteriors[i] = choiceLikelihoods[i] * priors[i];
        numeratorSum += posteriors[i];
      }
      
      probabilities = posteriors.map(val => val / numeratorSum);
      
      // Log Bayesian calculation
      logBayesianMath(currentTurn, selectedAllocIndex, priors, choiceLikelihoods, probabilities);
      
      // 3. Move to next turn & apply market volatility
      currentTurn++;
      
      if (currentTurn < 4) {
        // Apply market moves for the new turn
        const vols = VOLATILITIES[currentTurn];
        let previousTotal = totalValue;
        
        assetValues[0] = assetValues[0] * (1 + vols[0]);
        assetValues[1] = assetValues[1] * (1 + vols[1]);
        assetValues[2] = assetValues[2] * (1 + vols[2]);
        
        totalValue = assetValues[0] + assetValues[1] + assetValues[2];
        turnHistory.push(totalValue);
        
        // Update dashboard UI
        updateDashboard(vols, previousTotal);
        updateBeliefUI();
        
        // Reset selections
        selectedAllocIndex = -1;
        document.getElementById('next-turn-btn').setAttribute('disabled', 'true');
        for (let i = 0; i < 3; i++) {
          document.getElementById(`btn-choice-${i}`).classList.remove('selected');
        }
        
        // Update prompt text
        const state = MARKET_STATES[currentTurn];
        const ticker = document.getElementById('market-ticker');
        ticker.className = `market-tag ${state.tag}`;
        ticker.innerText = state.text;
        
        document.getElementById('step-title').innerText = `Season ${currentTurn + 1}: ${state.text}`;
        document.getElementById('step-desc').innerText = state.desc;
        
      } else {
        // Simulation Complete
        updateBeliefUI();
        showCompleteState();
      }
    }

    function updateDashboard(vols, previousTotal) {
      // Formats
      document.getElementById('total-balance').innerText = totalValue.toLocaleString('en-US', { maximumFractionDigits: 2 }) + ' Gold';
      
      // Gain/Loss percentage
      const totalChange = totalValue - previousTotal;
      const totalChangePct = (totalChange / previousTotal) * 100;
      const changeBadge = document.getElementById('daily-change');
      
      if (totalChange >= 0) {
        changeBadge.style.background = 'rgba(34, 197, 94, 0.15)';
        changeBadge.style.color = '#22c55e';
        changeBadge.style.borderColor = 'rgba(34, 197, 94, 0.3)';
        changeBadge.innerText = `+${totalChange.toFixed(0)} Gold (+${totalChangePct.toFixed(2)}%)`;
      } else {
        changeBadge.style.background = 'rgba(239, 68, 68, 0.15)';
        changeBadge.style.color = '#ef4444';
        changeBadge.style.borderColor = 'rgba(239, 68, 68, 0.3)';
        changeBadge.innerText = `-${Math.abs(totalChange).toFixed(0)} Gold (${totalChangePct.toFixed(2)}%)`;
      }
      
      // Update individual row values
      document.getElementById('bal-low').innerText = assetValues[0].toLocaleString('en-US', { maximumFractionDigits: 2 }) + ' Gold';
      document.getElementById('bal-med').innerText = assetValues[1].toLocaleString('en-US', { maximumFractionDigits: 2 }) + ' Gold';
      document.getElementById('bal-high').innerText = assetValues[2].toLocaleString('en-US', { maximumFractionDigits: 2 }) + ' Gold';
      
      const allocLow = ((assetValues[0] / totalValue) * 100);
      const allocMed = ((assetValues[1] / totalValue) * 100);
      const allocHigh = ((assetValues[2] / totalValue) * 100);
      
      document.getElementById('alloc-low').innerText = allocLow.toFixed(1) + '%';
      document.getElementById('alloc-med').innerText = allocMed.toFixed(1) + '%';
      document.getElementById('alloc-high').innerText = allocHigh.toFixed(1) + '%';
      
      document.getElementById('alloc-bar-low').style.width = allocLow + '%';
      document.getElementById('alloc-bar-med').style.width = allocMed + '%';
      document.getElementById('alloc-bar-high').style.width = allocHigh + '%';
      
      // Volatility text
      updateVolText('vol-low', vols[0]);
      updateVolText('vol-med', vols[1]);
      updateVolText('vol-high', vols[2]);
      
      // Update SVG chart path
      updateSVGChart();
    }

    function updateVolText(id, vol) {
      const el = document.getElementById(id);
      const pct = (vol * 100).toFixed(1);
      if (vol >= 0) {
        el.style.color = '#22c55e';
        el.innerText = `+${pct}%`;
      } else {
        el.style.color = '#ef4444';
        el.innerText = `${pct}%`;
      }
    }

    function updateSVGChart() {
      // Map portfolio values into y-coordinates from 10 to 90 (where 13,000 = 10 and 7,000 = 90)
      const mapY = (val) => {
        const minVal = 7000;
        const maxVal = 13000;
        const pct = (val - minVal) / (maxVal - minVal);
        const y = 90 - (pct * 80);
        return Math.max(10, Math.min(90, y)); // Clamp
      };
      
      let dPath = `M 20,${mapY(turnHistory[0])}`;
      document.getElementById('pt-0').setAttribute('cy', mapY(turnHistory[0]));
      
      for (let i = 1; i < turnHistory.length; i++) {
        const x = 20 + (i * 90);
        const y = mapY(turnHistory[i]);
        dPath += ` L ${x},${y}`;
        
        const pt = document.getElementById(`pt-${i}`);
        pt.setAttribute('cy', y);
        pt.style.display = 'block';
      }
      
      document.getElementById('history-line').setAttribute('d', dPath);
    }

    function logBayesianMath(turn, choiceIndex, priors, likelihoods, posteriors) {
      const container = document.getElementById('math-log-container');
      
      const strategies = ["Conservative", "Moderate", "Risky"];
      const headerEntry = document.createElement('div');
      headerEntry.className = 'math-entry header';
      headerEntry.innerText = `Season ${turn + 1}: Selected Rebalance to ${strategies[choiceIndex]}`;
      container.appendChild(headerEntry);
      
      const profileNames = ["Conservative", "Moderate", "Risky"];
      for (let i = 0; i < 3; i++) {
        const entry = document.createElement('div');
        entry.className = 'math-entry';
        
        const priorStr = priors[i].toFixed(4);
        const likeStr = likelihoods[i].toFixed(4);
        const postStr = posteriors[i].toFixed(4);
        
        entry.innerHTML = `P(Profile<sub>${profileNames[i]}</sub>) = ${priorStr} (Prior)<br>` +
                          `P(Rebalance | Profile<sub>${profileNames[i]}</sub>) = ${likeStr} (Likelihood)<br>` +
                          `P(Profile<sub>${profileNames[i]}</sub> | Rebalance) = <strong>${postStr}</strong> (Posterior)`;
        container.appendChild(entry);
      }
      
      container.scrollTop = container.scrollHeight;
    }

    function updateBeliefUI() {
      // Set progress texts
      document.getElementById('prob-cons').innerText = (probabilities[0] * 100).toFixed(1) + '%';
      document.getElementById('prob-mod').innerText = (probabilities[1] * 100).toFixed(1) + '%';
      document.getElementById('prob-aggr').innerText = (probabilities[2] * 100).toFixed(1) + '%';
      
      // Adjust progress bars
      document.getElementById('bar-cons').style.width = (probabilities[0] * 100) + '%';
      document.getElementById('bar-mod').style.width = (probabilities[1] * 100) + '%';
      document.getElementById('bar-aggr').style.width = (probabilities[2] * 100) + '%';
      
      // Update Advisor response
      let maxIndex = 0;
      let maxVal = probabilities[0];
      for (let i = 1; i < 3; i++) {
        if (probabilities[i] > maxVal) {
          maxVal = probabilities[i];
          maxIndex = i;
        }
      }
      
      // Check if tie
      const isTie = probabilities[0].toFixed(2) === probabilities[1].toFixed(2) && 
                    probabilities[1].toFixed(2) === probabilities[2].toFixed(2);
      
      // Toggle suggestion badges and row recommended borders
      for (let i = 0; i < 3; i++) {
        const hasMatch = (!isTie && i === maxIndex);
        document.getElementById(`rec-badge-${i}`).style.display = hasMatch ? 'inline-block' : 'none';
        
        const row = document.getElementById(`row-choice-${i}`);
        if (row) {
          if (hasMatch) {
            row.classList.add('recommended');
          } else {
            row.classList.remove('recommended');
          }
        }
      }
      
      document.getElementById('advisor-title').innerText = ADVISOR_RESPONSES[maxIndex].title;
      document.getElementById('advisor-text').innerText = ADVISOR_RESPONSES[maxIndex].text;
    }

    function showCompleteState() {
      document.getElementById('schwab-choices-box').style.display = 'none';
      document.getElementById('next-turn-btn').style.display = 'none';
      
      document.getElementById('reset-btn').style.display = 'inline-block';
      
      const stateCard = document.getElementById('schwab-choices-box').parentElement;
      
      const completeBox = document.createElement('div');
      completeBox.id = 'complete-summary';
      completeBox.className = 'celebration-box';
      completeBox.style.textAlign = 'center';
      completeBox.style.padding = '40px 20px';
      
      let maxIndex = 0;
      for (let i = 1; i < 3; i++) {
        if (probabilities[i] > probabilities[maxIndex]) {
          maxIndex = i;
        }
      }
      const finalProfile = maxIndex === 0 ? "Conservative" : maxIndex === 1 ? "Moderate" : "Risky";
      const totalGain = totalValue - 10000;
      const totalGainPct = (totalGain / 10000) * 100;
      const gainClass = totalGain >= 0 ? '#22c55e' : '#ef4444';
      const gainSign = totalGain >= 0 ? '+' : '';
      
      completeBox.innerHTML = `
        <div style="font-size: 4rem; margin-bottom: 20px;">💰</div>
        <div class="scenario-title" style="font-family: var(--font-heading); color: var(--tavern-gold); font-size: 1.5rem; margin-bottom:15px;">Vault Season Concluded!</div>
        <div class="scenario-description" style="color: var(--text-secondary); line-height: 1.6;">
          You finished the 4 cycles with a final treasury balance of 
          <strong>${totalValue.toLocaleString('en-US', { maximumFractionDigits: 2 })} Gold</strong> 
          (<span style="color:${gainClass}; font-weight:bold;">${gainSign}${totalGain.toFixed(0)} Gold [${gainSign}${totalGainPct.toFixed(2)}%]</span>).
          <br><br>
          Based on your treasury rebalancing choices under different market conditions, the Iron Bank Bayesian Master has classified your profile as a:
          <br><br>
          <span style="font-size:1.3rem; color:var(--emerald-light); font-weight:bold; text-transform:uppercase; letter-spacing:1px;">${finalProfile}</span> Investor
        </div>
      `;
      stateCard.insertBefore(completeBox, document.getElementById('reset-btn').parentElement);
    }

    function resetSimulator() {
      totalValue = 10000;
      assetValues = [3333.33, 3333.33, 3333.34];
      selectedAllocIndex = -1;
      turnHistory = [10000];
      probabilities = [0.3333, 0.3333, 0.3333];
      currentTurn = 0;
      
      const summary = document.getElementById('complete-summary');
      if (summary) summary.remove();
      
      document.getElementById('schwab-choices-box').style.display = 'block';
      document.getElementById('next-turn-btn').style.display = 'inline-block';
      document.getElementById('next-turn-btn').setAttribute('disabled', 'true');
      document.getElementById('reset-btn').style.display = 'none';
      
      for (let i = 0; i < 3; i++) {
        document.getElementById(`btn-choice-${i}`).classList.remove('selected');
        const row = document.getElementById(`row-choice-${i}`);
        if (row) {
          row.classList.remove('selected');
          row.classList.remove('recommended');
        }
      }
      
      const state = MARKET_STATES[0];
      const ticker = document.getElementById('market-ticker');
      ticker.className = `market-tag ${state.tag}`;
      ticker.innerText = state.text;
      
      document.getElementById('step-title').innerText = `Season 1: ${state.text}`;
      document.getElementById('step-desc').innerText = state.desc;
      
      const container = document.getElementById('math-log-container');
      container.innerHTML = `
        <div class="math-entry header">Prior risk model initialized.</div>
        <div class="math-entry">P(Conservative) = 0.333 | P(Moderate) = 0.333 | P(Risky) = 0.333</div>
      `;
      
      document.getElementById('advisor-title').innerText = "Iron Bank Advisor Guidance";
      document.getElementById('advisor-text').innerText = "Welcome to the treasury room. Choose a rebalancing strategy below. I will observe your allocation ratios across stable Dwarven bonds, moderate merchant stocks, and highly volatile crystal startups to assess your risk profile and advise you.";
      
      for (let i = 0; i < 3; i++) {
        document.getElementById(`rec-badge-${i}`).style.display = 'none';
      }
      
      for (let i = 1; i <= 4; i++) {
        document.getElementById(`pt-${i}`).style.display = 'none';
      }
      
      updateDashboard(VOLATILITIES[0], 10000);
      updateBeliefUI();
    }
    
    // Auto initialize on load
    window.addEventListener('load', () => {
      updateDashboard(VOLATILITIES[0], 10000);
      updateBeliefUI();
    });
